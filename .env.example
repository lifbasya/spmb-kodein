# Database Configuration (Prisma 7)
# Ganti dengan URL PostgreSQL lokal Anda
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spmb_db?schema=public"

# NextAuth Configuration
# Jalankan `openssl rand -base64 32` untuk membuat secret baru
NEXTAUTH_SECRET="your-development-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (Optional - For local file upload simulation)
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
