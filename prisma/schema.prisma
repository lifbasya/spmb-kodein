generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Role {
  ADMIN
  STUDENT
  USER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  ACCEPTED
  REJECTED
}

enum DocumentType {
  FAMILY_CARD
  BIRTH_CERTIFICATE
  REPORT_CARD
  PHOTO
  OTHER
}

// Models
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  applicant     Applicant?
}

model Applicant {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName          String
  nisn              String?           @unique
  birthPlace        String
  birthDate         DateTime
  gender            String
  religion          String
  phoneNumber       String
  address           String
  
  // Application fields
  schoolOrigin      String?
  parentName        String?
  parentPhone       String?
  
  status            ApplicationStatus @default(DRAFT)
  verifiedAt        DateTime?
  decidedAt         DateTime?
  
  documents         Document[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Document {
  id            String       @id @default(cuid())
  applicantId   String
  applicant     Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  
  type          DocumentType
  fileUrl       String
  fileName      String
  fileSize      Int
  cloudId       String?      // Untuk menyimpan Cloudinary Public ID
  
  createdAt     DateTime     @default(now())
}
